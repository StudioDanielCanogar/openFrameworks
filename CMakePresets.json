{
  "version": 2,
  "configurePresets": [
    {
      "name": "vcpkg-release",
      "generator": "Ninja",
      "displayName": "vcpkg Release",
      "binaryDir": "${sourceDir}/vcpkg-build-release",
      "environment": {
        "VCPKG_ROOT": "thirdParty/vcpkg"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/overlay-ports",
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "vcpkg-debug",
      "displayName": "vcpkg Debug",
      "description": "Debug build using vcpkg",
      "inherits": "vcpkg-release",
      "binaryDir": "${sourceDir}/vcpkg-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    }
  ]
}