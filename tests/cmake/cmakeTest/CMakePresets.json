{
  "version": 10,
  "configurePresets": [
    {
      "name": "vcpkg-default",
      "displayName": "vcpkg Default Configuration",
      "description": "Default build using vcpkg",
      "environment": {
        "OF_DIR": "${sourceDir}/../../../../openFrameworks",
        "VCPKG_ROOT": "$env{OF_DIR}/thirdParty/vcpkg"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_PORTS": "$env{OF_DIR}/overlay-ports",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "vcpkg-debug",
      "displayName": "vcpkg Debug",
      "description": "Debug build using vcpkg",
      "inherits": "vcpkg-default",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "vcpkg-release",
      "displayName": "vcpkg Release",
      "description": "Release build using vcpkg",
      "inherits": "vcpkg-default",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}