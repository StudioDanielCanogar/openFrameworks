{
  "version": 3,
  "configurePresets": [
    {
      "name": "vcpkg-default",
      "displayName": "vcpkg Default Configuration",
      "description": "Default build using vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-default",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "E:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/../../../vcpkg-ports",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "vcpkg-debug",
      "displayName": "vcpkg Debug",
      "description": "Debug build using vcpkg",
      "inherits": "vcpkg-default",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "vcpkg-release",
      "displayName": "vcpkg Release",
      "description": "Release build using vcpkg",
      "inherits": "vcpkg-default",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}